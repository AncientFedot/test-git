# Copy to /etc/bonifaciy/bonifaciy.env (Linux) or an equivalent secure host-level location.
# IMPORTANT: this file must NOT be committed with real keys.

# Keep data outside release directory.
BONIFACIY_DATA_DIR=/srv/bonifaciy/data

# Production secret backend (required)
BONIFACIY_SECRET_BACKEND=fernet

# Encryption key for secrets-at-rest.
# Generate with: python - <<'PY'\nfrom cryptography.fernet import Fernet; print(Fernet.generate_key().decode())\nPY
BONIFACIY_SECRET_KEY=REPLACE_WITH_FERNET_KEY

# Separate key for API token signing/validation (must differ from BONIFACIY_SECRET_KEY).
# Generate with: python main.py generate-signing-key
BONIFACIY_API_SIGNING_KEY=REPLACE_WITH_SIGNING_KEY

# Production runtime profile
BONIFACIY_ENV=production

# Must stay disabled in production.
BONIFACIY_ALLOW_INSECURE_SECRETS=0
