# Persistent storage root (must be outside release directory)
BONIFACIY_DATA_DIR=/srv/bonifaciy-data

# Secret backend for credentials at rest.
# Allowed values:
#   - fernet (production recommended, requires python package 'cryptography')
#   - insecure-xor (development only)
BONIFACIY_SECRET_BACKEND=fernet

# Required key for selected backend.
# For fernet backend use Fernet.generate_key() output.
BONIFACIY_SECRET_KEY=replace-with-generated-key

# Dedicated API token-signing key (must differ from encryption key)
BONIFACIY_API_SIGNING_KEY=replace-with-generated-signing-key

# Runtime profile: production|development|test|local
BONIFACIY_ENV=production

# Development-only escape hatch (ignored in production)
BONIFACIY_ALLOW_INSECURE_SECRETS=0
